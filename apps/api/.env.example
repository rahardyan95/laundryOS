APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true (wajib di produksi HTTPS)
# SESSION_SAME_SITE=lax

FRONTEND_URL=http://localhost:3000
# Origin yang diizinkan CORS — daftar dipisah koma; default = FRONTEND_URL.
# Tambahkan port dev lain yang dipakai (mis. 3100 untuk Playwright E2E).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000,127.0.0.1:8000,127.0.0.1:3000
# Masa berlaku token API untuk mobile (menit). Biarkan kosong = tanpa kedaluwarsa.
# SANCTUM_EXPIRATION=43200
# Daftar proxy yang boleh dipercaya (dipisah koma). Kosongkan bila API diakses
# langsung tanpa proxy — nilai salah satu "REMOTE_ADDR" atau subnet/IP proxy.
# JANGAN isi "*": klien lalu bisa memalsukan X-Forwarded-For dan melewati rate limit.
TRUSTED_PROXIES=

# Error tracking (kosongkan untuk menonaktifkan)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Foto bukti: "public" (default, butuh storage:link) atau "s3" (produksi multi-instance)
FILESYSTEM_PROOF_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
