---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Halaman tidak ditemukan — LaundryOS"
  description="Halaman yang Anda cari tidak ada."
  path="/404"
>
  <section>
    <div class="wrap" style="text-align: center;">
      <p class="eyebrow">404</p>
      <h1 class="hero" style="font-size: clamp(1.8rem, 4vw, 2.6rem);">Halaman tidak ditemukan</h1>
      <p style="color: var(--muted);">Coba kembali ke beranda atau lihat daftar harga.</p>
      <a class="btn btn-primary" href="/">Kembali ke beranda</a>
    </div>
  </section>
</BaseLayout>
