# Salin ke infra/.env.prod dan isi nilai asli. Jangan commit .env.prod.
#
# Topologi host yang dipakai di sini (lihat DEPLOY.md §5):
#   laundryos.example      -> situs pemasaran (apps/site)
#   app.laundryos.example  -> aplikasi dashboard/POS + API
# Ganti keduanya dengan domain asli; keduanya dipakai di nginx, CORS, dan build.

APP_NAME="LaundryOS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.laundryos.example

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laundry
DB_USERNAME=laundry
DB_PASSWORD=ubah-password-kuat
DB_SSLMODE=prefer

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ubah-password-redis-kuat

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FRONTEND_URL=https://app.laundryos.example
# Origin web yang boleh CORS (daftar dipisah koma). Berbeda dari FRONTEND_URL,
# yang satu origin dan dipakai untuk tautan reset kata sandi.
CORS_ALLOWED_ORIGINS=https://app.laundryos.example
SANCTUM_STATEFUL_DOMAINS=app.laundryos.example
# Hanya subnet nginx (lihat docker-compose.prod.yml) yang boleh dipercaya.
# Jangan pakai "*": klien bisa memalsukan X-Forwarded-For.
TRUSTED_PROXIES=172.28.0.0/16
SANCTUM_EXPIRATION=43200

MAIL_MAILER=smtp
MAIL_HOST=mail.example
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@laundryos.example"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_PROOF_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Error tracking
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- URL publik (dipakai saat build, bukan saat runtime) ---
# Host situs pemasaran (apps/site): canonical, sitemap.xml, robots.txt.
PUBLIC_SITE_URL=https://laundryos.example
# Host aplikasi (dashboard/POS): CTA situs, sitemap/robots web, image web.
# Build image situs menolak jalan bila PUBLIC_SITE_URL atau PUBLIC_APP_URL kosong.
PUBLIC_APP_URL=https://app.laundryos.example
PUBLIC_API_URL=https://app.laundryos.example/api/v1

# --- Tag image (opsional) ---
# Dipakai docker-compose.prod.yml: ${API_IMAGE:-laundryos-api:prod} dst.
# Isi hanya bila ingin memakai image lama secara khusus; deploy normal memakai
# deploy-prod.sh <versi> yang menyetel tag ini sendiri (DEPLOY.md §7).
# API_IMAGE=laundryos-api:prod
# WEB_IMAGE=laundryos-web:prod
# SITE_IMAGE=laundryos-site:prod
